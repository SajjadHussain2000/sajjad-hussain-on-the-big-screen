# Upstash Redis (leaderboards). Leave empty locally to use the in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bug Hunt code words for bugs 8-10 (JSON). Defaults are used when empty.
HUNT_CODES={"8":"SEMICOLON","9":"HIDEOUT","10":"TYPO404"}

# Required for DELETE /api/hunt (remove leaderboard entries)
ADMIN_SECRET=

# Optional: custom domain, e.g. https://sajjadhussain.dev (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
